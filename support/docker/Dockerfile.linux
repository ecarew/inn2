# Linux toolchain for building and testing INN++ with CMake: the normal
# checks as an ordinary user (support/docker-linux-checks.sh) and the checks
# that need root as the container's root (support/docker-root-checks.sh).
# The source is streamed in at run time, not copied into the image.  No
# Autoconf: the CMake build needs nothing from ./configure.
FROM debian:trixie

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       build-essential ninja-build perl python3 python3-venv flex bison \
       libsqlite3-dev zlib1g-dev ca-certificates procps netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# The CMake build requires CMake 4.3 or later, newer than Debian ships;
# take it from PyPI into a private virtual environment.
RUN python3 -m venv /opt/cmake \
    && /opt/cmake/bin/pip install --no-cache-dir 'cmake>=4.3' \
    && ln -s /opt/cmake/bin/cmake /opt/cmake/bin/ctest /usr/local/bin/

# The unprivileged account the root checks' build drops to
# (INN_RUNAS_USER/GROUP), and an ordinary user for the normal checks, who is
# not the news user (Debian's base image has a news account and group).
RUN groupadd newstest && useradd -g newstest -M -s /usr/sbin/nologin newstest \
    && useradd -m tester
