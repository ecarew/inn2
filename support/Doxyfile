# Doxygen configuration for browsing the INN++ sources with call graphs.
# Run from the repository root:  doxygen support/Doxyfile
# Output: build-doxygen/html/index.html (needs Graphviz's dot).

PROJECT_NAME           = "INN++"
PROJECT_BRIEF          = "INN converted to C++ and CMake"
OUTPUT_DIRECTORY       = build-doxygen

# The architecture overview as the main page, then all of INN's sources;
# not tests/ (the test programs), cmake/ (feature checks) or the rest of
# support/.
INPUT                  = support/doxygen-mainpage.md \
                         include lib history storage innd nnrpd innfeed \
                         frontends backends expire control authprogs contrib
FILE_PATTERNS          = *.cc *.c *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build*/*
EXTENSION_MAPPING      = h=C++

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
EXTRACT_LOCAL_CLASSES  = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

HAVE_DOT               = YES
DOT_NUM_THREADS        = 8
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_GRAPH_MAX_NODES    = 100
# UML-style class and collaboration diagrams: each class or struct with its
# members, and the classes it uses.  (From https://stackoverflow.com/a/38322858;
# CLASS_DIAGRAMS and DOT_TRANSPARENT there are obsolete in Doxygen 1.18.)
HIDE_UNDOC_RELATIONS   = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 50
TEMPLATE_RELATIONS     = YES
MAX_DOT_GRAPH_DEPTH    = 0
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
SEARCHENGINE           = YES

QUIET                  = YES
WARNINGS               = NO
WARN_IF_UNDOCUMENTED   = NO
