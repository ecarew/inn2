# Doxygen configuration for browsing the INN++ sources with call graphs.
# Run from the repository root:  doxygen support/Doxyfile
# Output: build-doxygen/html/index.html (needs Graphviz's dot).

PROJECT_NAME           = "INN++"
PROJECT_BRIEF          = "INN converted to C++ and CMake"
OUTPUT_DIRECTORY       = build-doxygen

INPUT                  = innd lib history storage include
FILE_PATTERNS          = *.cc *.c *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build*/*
EXTENSION_MAPPING      = h=C++

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
EXTRACT_LOCAL_CLASSES  = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

HAVE_DOT               = YES
DOT_NUM_THREADS        = 8
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_GRAPH_MAX_NODES    = 60
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
SEARCHENGINE           = YES

QUIET                  = YES
WARNINGS               = NO
WARN_IF_UNDOCUMENTED   = NO
