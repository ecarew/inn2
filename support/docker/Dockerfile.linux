# Linux toolchain for building INN++ with CMake and running the checks that
# need root (support/root-checks.sh) as the container's root.  Used by
# support/docker-root-checks.sh; the source is streamed in at run time, not
# copied into the image.
FROM debian:trixie

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       build-essential autoconf perl python3 python3-venv flex bison \
       libsqlite3-dev zlib1g-dev ca-certificates procps netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# The CMake build requires CMake 4.3 or later, newer than Debian ships;
# take it from PyPI into a private virtual environment.
RUN python3 -m venv /opt/cmake \
    && /opt/cmake/bin/pip install --no-cache-dir 'cmake>=4.3' \
    && ln -s /opt/cmake/bin/cmake /usr/local/bin/cmake

# The unprivileged account the build drops to (INN_RUNAS_USER/GROUP).
RUN groupadd newstest && useradd -g newstest -M -s /usr/sbin/nologin newstest
