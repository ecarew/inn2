%{
/*
**  A yacc input file for the innfeed config file.
**
**  Written by James Brister <brister@vix.com>
**
**  This file contains the heart of the innfeed configuration parser, written
**  in yacc.  It uses an external lexer generated by flex.
**
**  Names and string values are std::string.  yacc's value stack holds only
**  plain types, so the lexer hands each token's text to configToken(),
**  which keeps it in tokenPool for the rest of the parse; the grammar reads
**  it through a const char * and never frees it.
**
**  clang-format does not work off-the-shelf with mixed C and yacc code;
**  if it is run, the "%{" and "%}" lines should be commented so as not
**  to add extra indentation.
*/

#include "portable/system.h"

#include "innfeed.h"
#include <algorithm>
#include <cctype>
#include <cerrno>
#include <deque>
#include <string>
#include <string_view>
#include <syslog.h>
#include <utility>
#include <vector>

#include "inn/libinn.h"
#include "inn/messages.h"

#include "configfile.h"
#include "misc.h"

/* flex does not declare yydebug as static, and uses superfluous breaks. */
#if defined(__llvm__) || defined(__clang__)
# pragma GCC diagnostic ignored "-Wmissing-variable-declarations"
# pragma GCC diagnostic ignored "-Wunreachable-code-break"
#endif

#define UNKNOWN_SCOPE_TYPE "line %d: unknown scope type: %s"
#define SYNTAX_ERROR       "line %d: syntax error"

scope *topScope = nullptr;
static scope *currScope = nullptr;
std::string errbuff;

/* Every token's text for the current parse (see the comment at the top).
   A deque, so earlier tokens stay put as later ones are added. */
static std::deque<std::string> tokenPool;

static std::string valueScopedName(const value *v);
static void freeValue(value *v);
static std::string checkName(scope *s, const char *name);
static void addValue(scope *s, value *v);
static std::string addScope(scope *s, const char *name, scope *val);
static void printScope(FILE *fp, scope *s, int indent);
static void printValue(FILE *fp, value *v, int indent);
static scope *newScope(const char *type);

/* Interface between lexer and parser. */
int yylex(void);

int yyerror(const char *s);


const char *
configToken(std::string text)
{
    tokenPool.push_back(std::move(text));
    return tokenPool.back().c_str();
}


/* A formatted error message, as xasprintf would make it. */
static std::string
formatted(const char *fmt, int line, const char *arg = nullptr)
{
    char *p;
    std::string s;

    if (arg == nullptr)
        xasprintf(&p, fmt, line);
    else
        xasprintf(&p, fmt, line, arg);
    s = p;
    free(p);
    return s;
}


int
getBool(scope *s, const char *name, int *rval, int inherit)
{
    value *v = findValue(s, name, inherit);

    if (v == nullptr || v->type != boolval)
        return 0;

    *rval = v->v.bool_val;
    return 1;
}


bool
getString(scope *s, const char *name, std::string &rval, int inherit)
{
    value *v = findValue(s, name, inherit);

    if (v == nullptr || v->type != stringval)
        return false;

    rval = v->string_val;
    return true;
}

int
getReal(scope *s, const char *name, double *rval, int inherit)
{
    value *v = findValue(s, name, inherit);

    if (v == nullptr || v->type != realval)
        return 0;

    *rval = v->v.real_val;
    return 1;
}

int
getInteger(scope *s, const char *name, long *rval, int inherit)
{
    value *v = findValue(s, name, inherit);

    if (v == nullptr || v->type != intval)
        return 0;

    *rval = v->v.int_val;
    return 1;
}

void
freeScopeTree(scope *s)
{
    if (s == nullptr)
        return;

    if (s->parent == nullptr && s->me != nullptr) /* top level scope */
        delete s->me;

    for (value *v : s->values)
        if (v != nullptr)
            freeValue(v);

    delete s;
}


/* A new value named name, added to s, unless s already has one; returns
   the error message then, or "". */
static std::string
newValue(scope *s, const char *name, tag type, value **made)
{
    std::string error = checkName(currScope, name);

    if (!error.empty())
        return error;

    *made = new value;
    (*made)->name = name;
    (*made)->type = type;
    addValue(s, *made);
    return std::string();
}

std::string
addInteger(scope *s, const char *name, long val)
{
    value *v;
    std::string error = newValue(s, name, intval, &v);

    if (error.empty())
        v->v.int_val = val;
    return error;
}

std::string
addChar(scope *s, const char *name, char val)
{
    value *v;
    std::string error = newValue(s, name, charval, &v);

    if (error.empty())
        v->v.char_val = val;
    return error;
}

std::string
addBoolean(scope *s, const char *name, int val)
{
    value *v;
    std::string error = newValue(s, name, boolval, &v);

    if (error.empty())
        v->v.bool_val = val;
    return error;
}

std::string
addReal(scope *s, const char *name, double val)
{
    value *v;
    std::string error = newValue(s, name, realval, &v);

    if (error.empty())
        v->v.real_val = val;
    return error;
}

std::string
addString(scope *s, const char *name, std::string_view val)
{
    value *v;
    std::string error = newValue(s, name, stringval, &v);

    if (error.empty())
        v->string_val = val;
    return error;
}

void
setString(scope *s, const char *name, std::string_view val)
{
    value *v = findValue(s, name, NO_INHERIT);

    if (v != nullptr) {
        v->type = stringval;
        v->string_val = val;
    } else
        addString(s, name, val);
}

value *
findValue(scope *s, const char *name, int inherit)
{
    const char *p;

    if (name == nullptr || *name == '\0')
        return nullptr;

    if (*name == ':')
        return findValue(topScope, name + 1, 0);
    else if (s == nullptr)
        return findValue(topScope, name, 0);
    else {
        if ((p = strchr(name, ':')) == nullptr)
            p = name + strlen(name);
        std::string_view segment(name, p - name);

        for (value *v : s->values) {
            if (v->name == segment) {
                if (*p == '\0') /* last segment of name */
                    return v;
                else if (v->type != scopeval)
                    errbuff = "Component not a scope";
                else
                    return findValue(v->v.scope_val, p + 1, 0);
            }
        }

        /* not in this scope. Go up if inheriting values and only if no ':'
           in name */
        if (inherit && *p == '\0')
            return findValue(s->parent, name, inherit);
    }

    return nullptr;
}

/* find the scope that name belongs to. If mustExist is true then the name
   must be a fully scoped name of a value. relative scopes start at s. */
scope *
findScope(scope *s, const char *name, int mustExist)
{
    const char *q;

    if ((q = strchr(name, ':')) == nullptr) {
        if (!mustExist)
            return s;
        for (value *v : s->values)
            if (v->name == name)
                return s;
        return nullptr;
    } else if (*name == ':') {
        while (s->parent != nullptr)
            s = s->parent;

        return findScope(s, name + 1, mustExist);
    } else {
        std::string_view segment(name, q - name);

        for (value *v : s->values)
            if (v->name.compare(0, segment.size(), segment) == 0)
                if (v->type == scopeval)
                    return findScope(v->v.scope_val, q + 1, mustExist);
    }

    return nullptr;
}

/****************************************************************************/
/*                                                                          */
/****************************************************************************/


/* The value's name with the names of the scopes it is in, as
   "peer:name:". */
static std::string
valueScopedName(const value *v)
{
    std::string scoped;

    for (scope *p = v->myscope; p != nullptr; p = p->parent)
        scoped.insert(0, p->me->name + ":");
    return scoped + v->name;
}

static void
freeValue(value *v)
{
    if (v->type == scopeval)
        freeScopeTree(v->v.scope_val);
    delete v;
}

static std::string
checkName(scope *s, const char *name)
{
    if (s == nullptr)
        return std::string();

    for (value *v : s->values)
        if (v->name == name)
            return "Two definitions of " + valueScopedName(v);

    return std::string();
}


static void
addValue(scope *s, value *v)
{
    v->myscope = s;

    if (s != nullptr)
        s->values.push_back(v);
}


static std::string
addScope(scope *s, const char *name, scope *val)
{
    std::string error = checkName(s, name);

    if (!error.empty())
        return error;

    value *v = new value;
    v->name = name;
    v->type = scopeval;
    v->v.scope_val = val;
    val->me = v;
    val->parent = s;

    addValue(s, v);

    currScope = val;

    return std::string();
}


static void
printScope(FILE *fp, scope *s, int indent)
{
    for (value *v : s->values)
        printValue(fp, v, indent + 5);
}

static void
printValue(FILE *fp, value *v, int indent)
{
    int i;
    const char *name = v->name.c_str();

    for (i = 0; i < indent; i++)
        fputc(' ', fp);

    switch (v->type) {
    case intval:
        fprintf(fp, "%s : %ld # INTEGER\n", name, v->v.int_val);
        break;

    case stringval:
        fprintf(fp, "%s : \"", name);
        for (char c : v->string_val) {
            if (c == '"' || c == '\\')
                fputc('\\', fp);
            fputc(c, fp);
        }
        fprintf(fp, "\" # STRING\n");
        break;

    case charval:
        fprintf(fp, "%s : %c", name, 047);
        switch (v->v.char_val) {
        case '\\':
            fprintf(fp, "\\\\");
            break;

        default:
            if (isprint((unsigned char) v->v.char_val))
                fprintf(fp, "%c", v->v.char_val);
            else
                fprintf(fp, "\\%03o", (unsigned int) v->v.char_val);
        }
        fprintf(fp, "%c # CHARACTER\n", 047);
        break;

    case realval:
        fprintf(fp, "%s : %f # REAL\n", name, v->v.real_val);
        break;

    case boolval:
        fprintf(fp, "%s : %s # BOOLEAN\n", name,
                (v->v.bool_val ? "true" : "false"));
        break;

    case scopeval:
        fprintf(fp, "%s %s { # SCOPE\n", v->v.scope_val->scope_type.c_str(),
                name);
        printScope(fp, v->v.scope_val, indent + 5);
        for (i = 0; i < indent; i++)
            fputc(' ', fp);
        fprintf(fp, "}\n");
        break;

    default:
        fprintf(fp, "UNKNOWN value type: %u\n", v->type);
        exit(1);
    }
}


static scope *
newScope(const char *type)
{
    scope *t = new scope;

    t->scope_type = type;
    for (char &c : t->scope_type)
        c = tolower((unsigned char) c);

    return t;
}


#define BAD_KEY   "line %d: illegal key name: %s"
#define NON_ALPHA "line %d: keys must start with a letter: %s"

static std::string
keyOk(const char *key)
{
    const char *p = key;

    if (key == nullptr)
        return formatted("line %d: NULL key", lineCount);
    else if (*key == '\0')
        return formatted("line %d: EMPTY KEY", lineCount);

    if (!isalpha((unsigned char) *p))
        return formatted(NON_ALPHA, lineCount, key);

    p++;
    while (*p) {
        if (!(isalnum((unsigned char) *p) || *p == '_' || *p == '-'))
            return formatted(BAD_KEY, lineCount, key);
        p++;
    }

    return std::string();
}

/* The load callbacks and the stream each is given. */
static std::vector<std::pair<ConfigLoadCbk, std::FILE *>> callbacks;

void
configAddLoadCallback(ConfigLoadCbk func, std::FILE *arg)
{
    if (func != nullptr)
        callbacks.emplace_back(func, arg);
}


void
configRemoveLoadCallback(ConfigLoadCbk func)
{
    auto it = std::find_if(callbacks.begin(), callbacks.end(),
                           [func](const auto &c) { return c.first == func; });

    if (it != callbacks.end())
        callbacks.erase(it);
}


static int
doCallbacks(void)
{
    int rval = 1;

    for (const auto &c : callbacks)
        if (c.first != nullptr)
            rval = (c.first(c.second) && rval);

    return rval;
}


static const char *key;
/* clang-format off */
%}

%union {
    scope *scp;
    value *val;
    const char *name;
    int integer;
    double real;
    const char *string;
    char chr;
}

%token PEER
%token GROUP
%token <integer> IVAL
%token <real> RVAL
%token NAME
%token <string> XSTRING
%token SCOPE
%token COLON
%token LBRACE
%token RBRACE
%token <name> TRUEBVAL
%token <name> FALSEBVAL
%token <chr> CHAR
%token <name> WORD
%token IP_ADDRESS

%%

input: {
        lineCount = 1;
        addScope(NULL, "", newScope(""));
        topScope = currScope;
    } entries {
        if (!doCallbacks())
            YYABORT;
    };

scope: entries;

entries:
    | entries entry
    | entries error {
        errbuff = formatted(SYNTAX_ERROR, lineCount);
        YYABORT;
    };

entry: PEER WORD LBRACE {
        errbuff = addScope(currScope, $2, newScope("peer"));
        if (!errbuff.empty())
            YYABORT;
    } scope RBRACE { currScope = currScope->parent; }
    | GROUP WORD LBRACE {
        errbuff = addScope(currScope, $2, newScope("group"));
        if (!errbuff.empty())
            YYABORT;
    } scope RBRACE { currScope = currScope->parent; }
    | WORD WORD LBRACE {
        errbuff = formatted(UNKNOWN_SCOPE_TYPE, lineCount, $1);
        YYABORT;
    }
    | WORD {
    if (!(errbuff = keyOk($1)).empty()) {
        YYABORT;
    } else
        key = $1;
    } COLON value;

value: WORD {
        if (!(errbuff = addString(currScope, key, $1)).empty())
            YYABORT;
    }
    | IVAL {
        if (!(errbuff = addInteger(currScope, key, $1)).empty())
            YYABORT;
    }
    | TRUEBVAL {
        if (!(errbuff = addBoolean(currScope, key, 1)).empty())
            YYABORT;
    }
    | FALSEBVAL {
        if (!(errbuff = addBoolean(currScope, key, 0)).empty())
            YYABORT;
    }
    | RVAL {
        if (!(errbuff = addReal(currScope, key, $1)).empty())
            YYABORT;
    }
    | XSTRING {
        if (!(errbuff = addString(currScope, key, $1)).empty())
            YYABORT;
    }
    | CHAR {
        if (!(errbuff = addChar(currScope, key, $1)).empty())
            YYABORT;
    };

%%
/* clang-format on */

int
yyerror(const char *s)
{
    errbuff = formatted("line %d: %s", lineCount, s);
    return 0;
}

extern FILE *yyin;
int yydebug;


#if !defined(WANT_MAIN)

/* The peers, in the order the configuration defines them. */
static std::vector<std::pair<std::string, value *>> peerTable;

void
configCleanup(void)
{
    peerTable.clear();
    freeScopeTree(topScope);
    topScope = nullptr;
    callbacks.clear();
}


int
buildPeerTable(FILE *fp, scope *s)
{
    int rval = 1;

    for (value *v : s->values) {
        if (ISSCOPE(v) && ISPEER(v)) {
            auto same = std::find_if(peerTable.begin(), peerTable.end(),
                                     [v](const auto &peer) {
                                         return peer.first == v->name;
                                     });
            if (same != peerTable.end()) {
                logOrPrint(LOG_ERR, fp,
                           "ME config: two peers with the same name: %s",
                           same->first.c_str());
                rval = 0;
            } else
                peerTable.emplace_back(v->name, v);
        } else if (ISSCOPE(v))
            rval = (buildPeerTable(fp, v->v.scope_val) && rval);
    }

    return rval;
}


/* read the config file. Any errors go to errorDest if it is non-NULL,
   otherwise they are syslogged. If justCheck is true then return after
   parsing */
static int inited = 0;
int
readConfig(const char *file, FILE *errorDest, int justCheck, int dump)
{
    scope *oldTop = topScope;
    FILE *fp;
    int rval;

    if (!inited) {
        inited = 1;
        yydebug = (getenv("YYDEBUG") == NULL ? 0 : 1);
        if (yydebug)
            atexit(configCleanup);
    }

    if (file == NULL || strlen(file) == 0 || !fileExistsP(file)) {
        logOrPrint(LOG_ERR, errorDest,
                   "ME config aborting, no such config file: %s",
                   file ? file : "(null)");
        d_printf(1, "No such config file: %s\n", file ? file : "(null)");
        exit(1);
    }

    if ((fp = fopen(file, "r")) == NULL) {
        logOrPrint(LOG_ERR, errorDest, "ME config aborting fopen %s: %s", file,
                   strerror(errno));
        exit(1);
    }

    logOrPrint(LOG_NOTICE, errorDest, "loading %s", file);

    yyin = fp;

    topScope = NULL;
    errbuff.clear();

    rval = yyparse();
    tokenPool.clear();

    fclose(fp);

    if (rval != 0) /* failure */
    {
        freeScopeTree(topScope);
        if (justCheck)
            freeScopeTree(oldTop);
        else
            topScope = oldTop;
        topScope = NULL;

        if (!errbuff.empty()) {
            if (errorDest != NULL)
                fprintf(errorDest, "config file error: %s\n", errbuff.c_str());
            else
                warn("ME config file error: %s", errbuff.c_str());
            errbuff.clear();
        }

        return 0;
    }

    if (dump) {
        fprintf(errorDest ? errorDest : stderr, "Parsed config file:\n");
        printScope(errorDest ? errorDest : stderr, topScope, -5);
        fprintf(errorDest ? errorDest : stderr, "\n");
    }

    if (justCheck) {
        freeScopeTree(topScope);
        freeScopeTree(oldTop);

        topScope = NULL;
    } else {
        peerTable.clear();
        if (!buildPeerTable(errorDest, topScope))
            logAndExit(1, "Failed to build list of peers");
    }

    return 1;
}


value *
getNextPeer(int *cookie)
{
    if (*cookie < 0 || (size_t) *cookie >= peerTable.size())
        return NULL;

    return peerTable[(*cookie)++].second;
}


value *
findPeer(const char *name)
{
    for (const auto &peer : peerTable)
        if (peer.first == name)
            return peer.second;

    return NULL;
}

#endif

#if defined(WANT_MAIN)
int
main(int argc, char **argv)
{
    if (yyparse())
        printf("parsing failed: %s\n",
               errbuff.empty() ? "NONE" : errbuff.c_str());
    else {
        printScope(stdout, topScope, -5);

        if (argc == 3) {
            value *v = findValue(topScope, argv[1], 1);

            if (v == NULL)
                printf("Can't find %s\n", argv[1]);
            else {
                long ival = 987654;

                if (getInteger(v->v.scope_val, argv[2], &ival, 1))
                    printf("Getting %s : %ld", argv[2], ival);
                else
                    printf("Name is not legal: %s\n", argv[2]);
            }
        } else if (argc == 2) {
            value *v = findValue(topScope, argv[1], 1);

            if (v == NULL)
                printf("Can't find %s\n", argv[1]);
            else {
                printf("Getting %s : ", argv[1]);
                printValue(stdout, v, 0);
            }
        }
    }

    freeScopeTree(topScope);

    return 0;
}
#endif /* defined (WANT_MAIN) */
